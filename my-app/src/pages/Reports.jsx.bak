import React from 'react';
import { useReports } from '../hooks/useReports';
import { useModal } from '../hooks/useModal';
import ReportDetailsModal from '../components/admin/ReportDetailsModal';

/**
 * Reports management page
 */
function Reports() {
  const {
    reports,
    loading,
    error,
    currentPage,
    pageSize,
    totalCount,
    hasMore,
    filters,
    handlePageChange,
    handleStatusFilter,
    clearFilters,
    resolveReport
  } = useReports();

  const { 
    isOpen: isModalOpen, 
    selectedItem: selectedReport, 
    openModal, 
    closeModal 
  } = useModal();

  const handleNewReport = () => {
    console.log('Create new report');
  };

  const handleViewReport = (report) => {
    openModal(report);
  };

  const handleApproveReport = async (reportId) => {
    const result = await resolveReport(reportId, true);
    if (result.success) {
      closeModal();
    } else {
      alert(result.error);
    }
  };

  const handleRejectReport = async (reportId) => {
    const result = await resolveReport(reportId, false);
    if (result.success) {
      closeModal();
    } else {
      alert(result.error);
    }
  };

  // Loading state
  if (loading) {
    return (
      <div className="container mt-4">
        <div className="d-flex justify-content-center">
          <div className="spinner-border" role="status">
            <span className="visually-hidden">Loading...</span>
          </div>
        </div>
      </div>
    );
  }

  // Error state
  if (error) {
    return (
      <div className="container mt-4">
        <div className="alert alert-danger" role="alert">
          <h4 className="alert-heading">Error!</h4>
          <p>{error}</p>
        </div>
      </div>
    );
  }

  return (
    <div className="container mt-4">
      <div className="d-flex justify-content-between align-items-center mb-4">
        <h1>Reports Management</h1>
        <button 
          className="btn btn-primary"
          onClick={handleNewReport}
          type="button"
        >
          + New Report
        </button>
      </div>

      <div className="row mb-3">
        <div className="col-md-8">
          <div className="btn-group" role="group" aria-label="Status filters">
            <button 
              className={`btn ${!filters.status ? 'btn-primary' : 'btn-outline-primary'}`}
              onClick={clearFilters}
              type="button"
            >
              All
            </button>
            <button 
              className={`btn ${filters.status === 'Pending' ? 'btn-warning' : 'btn-outline-warning'}`}
              onClick={() => handleStatusFilter('Pending')}
              type="button"
            >
              Pending
            </button>
            <button 
              className={`btn ${filters.status === 'Resolved' ? 'btn-success' : 'btn-outline-success'}`}
              onClick={() => handleStatusFilter('Resolved')}
              type="button"
            >
              Resolved
            </button>
          </div>
        </div>
        <div className="col-md-4 text-end">
          <small className="text-muted">
            Showing {reports.length} of {totalCount} reports
          </small>
        </div>
      </div>
      
      <div className="row">
        <div className="col-12">
          <div className="card">
            <div className="card-body">
              <div className="table-responsive">
                <table className="table table-striped">
                  <thead>
                    <tr>
                      <th scope="col">ID</th>
                      <th scope="col">Reporter</th>
                      <th scope="col">Reported User</th>
                      <th scope="col">Reason</th>
                      <th scope="col">Status</th>
                      <th scope="col">Date</th>
                      <th scope="col">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    {reports.length === 0 ? (
                      <tr>
                        <td colSpan="7" className="text-center py-4">
                          <em>No reports found</em>
                        </td>
                      </tr>
                    ) : (
                      reports.map(report => (
                        <tr key={report.id}>
                          <td>{report.id}</td>
                          <td>{report.reporterUsername || report.reporterUserId}</td>
                          <td>{report.reportedUsername || report.reportedUserId}</td>
                          <td>
                            <span className="badge bg-info">{report.reason}</span>
                          </td>
                          <td>
                            <span className={`badge ${
                              report.status === 'Pending' ? 'bg-warning text-dark' : 
                              report.status === 'Resolved' ? 'bg-success' : 'bg-danger'
                            }`}>
                              {report.status}
                            </span>
                          </td>
                          <td>{new Date(report.reportDate || report.createdAt).toLocaleDateString()}</td>
                          <td>
                            <div className="btn-group" role="group" aria-label="Report actions">
                              <button 
                                className="btn btn-sm btn-outline-primary"
                                onClick={() => handleViewReport(report)}
                                title="View Details"
                                type="button"
                              >
                                👁️
                              </button>
                              {report.status === 'Pending' && (
                                <>
                                  <button 
                                    className="btn btn-sm btn-outline-success"
                                    onClick={() => handleApproveReport(report.id)}
                                    title="Approve Report"
                                    type="button"
                                  >
                                    ✅
                                  </button>
                                  <button 
                                    className="btn btn-sm btn-outline-danger"
                                    onClick={() => handleRejectReport(report.id)}
                                    title="Reject Report"
                                    type="button"
                                  >
                                    ❌
                                  </button>
                                </>
                              )}
                            </div>
                          </td>
                        </tr>
                      ))
                    )}
                  </tbody>
                </table>
              </div>
            </div>
            
            <div className="card-footer">
              <nav aria-label="Reports pagination">
                <ul className="pagination pagination-sm mb-0 justify-content-center">
                  <li className={`page-item ${currentPage === 1 ? 'disabled' : ''}`}>
                    <button 
                      className="page-link"
                      onClick={() => handlePageChange(currentPage - 1)}
                      disabled={currentPage === 1}
                      type="button"
                      aria-label="Previous page"
                    >
                      Previous
                    </button>
                  </li>
                  
                  {[...Array(Math.ceil(totalCount / pageSize))].map((_, index) => {
                    const pageNum = index + 1;
                    return (
                      <li key={pageNum} className={`page-item ${currentPage === pageNum ? 'active' : ''}`}>
                        <button 
                          className="page-link"
                          onClick={() => handlePageChange(pageNum)}
                          type="button"
                          aria-label={`Go to page ${pageNum}`}
                        >
                          {pageNum}
                        </button>
                      </li>
                    );
                  })}
                  
                  <li className={`page-item ${!hasMore ? 'disabled' : ''}`}>
                    <button 
                      className="page-link"
                      onClick={() => handlePageChange(currentPage + 1)}
                      disabled={!hasMore}
                      type="button"
                      aria-label="Next page"
                    >
                      Next
                    </button>
                  </li>
                </ul>
              </nav>
            </div>
          </div>
        </div>
      </div>
      
      <ReportDetailsModal
        report={selectedReport}
        isOpen={isModalOpen}
        onClose={closeModal}
        onApprove={handleApproveReport}
        onReject={handleRejectReport}
      />
    </div>
  );
}

export default Reports;